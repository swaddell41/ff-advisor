# Copy this file to .env and fill in your values.

# Your Sleeper user ID (find it at sleeper.com/settings or via /v1/user/{username})
SLEEPER_USER_ID=

# Comma-separated Sleeper league IDs (current season; chain-walking fetches prior seasons)
LEAGUE_IDS=

# Optional: Anthropic API key for Phase 3 LLM scouting reports
# If absent, the "Generate Scouting Report" button is disabled in the UI.
ANTHROPIC_API_KEY=

# Path to the SQLite database file (default shown)
DB_PATH=../data/dynasty.db
